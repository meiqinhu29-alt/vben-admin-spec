# ============================================
# 生产环境配置模板
# 使用方法: cp .env.production.example .env.production
# 然后修改下面所有 CHANGE_ME 为真实值
# ============================================

# --- PostgreSQL ---
POSTGRES_USER=vben
POSTGRES_PASSWORD=CHANGE_ME_strong_password
POSTGRES_DB=shop_bookkeeping

# --- Backend (NestJS) ---
JWT_ACCESS_SECRET=CHANGE_ME_run_openssl_rand_hex_32
JWT_REFRESH_SECRET=CHANGE_ME_run_openssl_rand_hex_32
JWT_ACCESS_EXPIRES_IN=8h
JWT_REFRESH_EXPIRES_IN=7d
CORS_ORIGIN=http://YOUR_ECS_PUBLIC_IP

# --- MinIO (对象存储) ---
MINIO_ROOT_USER=minio_admin
MINIO_ROOT_PASSWORD=CHANGE_ME_minio_password

# --- Frontend ---
FRONTEND_PORT=80
