    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "default": "./dist/index.js"
    },
    "./global": {
      "types": "./global.d.ts"
    }
  },
  "scripts": {
    "build": "tsup"
  },
  "dependencies": {
    "@vben-core/typings": "workspace:*",
    "class-transformer": "catalog:",
    "class-validator": "catalog:",
    "vue": "catalog:",
    "vue-router": "catalog:"
  },
  "devDependencies": {
    "@vben/tsconfig": "workspace:*",
    "tsup": "catalog:"
  }
}
